# karum-client environment variables.
#
# The Flutter client does not read a .env file at runtime. Its configuration is
# supplied at build/run time via `--dart-define=NAME=value` (compile-time
# constants resolved by `String.fromEnvironment`). The authoritative cross-repo
# list of runtime env vars lives in karum-infra/.env.example.
#
# Examples:
#
#   # Local Compose
#   flutter run -d chrome --dart-define=GATEWAY_URL=http://localhost:8080
#
#   # Production
#   flutter build web --dart-define=GATEWAY_URL=https://gateway.example.com

# --- Required at build/run time --------------------------------------------
# The base URL of the Karum gateway. Falls back to http://localhost:8080 when
# not supplied, so `flutter run` works out of the box.
# Maps to: (no env var; dart-define only)
GATEWAY_URL=http://localhost:8080

# --- Optional --------------------------------------------------------------
# Browser key for the Maps JavaScript API. Empty keeps the OpenStreetMap/CARTO
# map. `make local` passes the value from GOOGLE_MAPS_WEB_KEY.
# Maps to: GOOGLE_MAPS_WEB_KEY (karum-infra/.env.example)
GOOGLE_MAPS_WEB_KEY=

# Key for the Google Places API (place details, photos, etc.). Empty means
# place details are not fetched.
# Maps to: GOOGLE_PLACES_API_KEY (karum-infra/.env.example)
GOOGLE_PLACES_API_KEY=

# Hackathon judges banner on the login screen. Default: on in debug/profile,
# off in release. Set `true` to force it on in a release demo build, or
# `false` to hide it while developing. The gateway's HACKATHON_MODE must also
# be true for the one-tap demo to work.
# Maps to: HACKATHON_MODE (karum-infra/.env.example) — but this is a client
# display flag only; the one-tap demo still needs the gateway flag.
SHOW_JUDGES_BANNER=
